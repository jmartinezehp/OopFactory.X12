<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <PackageId>EHP.X12.Hipaa</PackageId>
    <Version>1.1.0</Version>
    <Authors>OopFactory, KeyMark Inc., E-Health Partners, Inc.</Authors>
    <Company>E-Health Partners, Inc.</Company>
    <Description>Fork of OopFactory.X12 with HIPAA transaction set extensions, updated for .NET 10.</Description>
    <PackageLicenseExpression>CDDL-1.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yourfork/OopFactory.X12</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yourfork/OopFactory.X12</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OopFactory.X12\OopFactory.X12.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Eligibility\Services\Xsl\X12-271-To-BenefitResponse.xslt">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Eligibility\Services\Xsl\BenefitResponse-To-Html.xslt" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Claims\Services\Xsl\X12-837-To-ClaimDocument.xslt">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Claims\Services\Xsl\FormDocument-To-FoXml.xslt" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ClaimDocument.xsd">
      <SubType>Designer</SubType>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
</Project>